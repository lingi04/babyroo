{
  "name": "babyroo-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build && cp -R src/generated dist/generated && cp -R static dist/static",
    "db:deploy": "prisma migrate deploy && prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:seed:events": "prisma generate && node scripts/import-events.js",
    "db:studio": "prisma studio",
    "start": "node dist/main.js",
    "start:dev": "prisma generate && nest start --watch",
    "typecheck": "prisma generate && tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@vercel/blob": "^2.8.0",
    "@vercel/functions": "^3.9.5",
    "dotenv": "^17.4.2",
    "google-auth-library": "^11.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/node": "^22.10.2",
    "prisma": "^7.9.1",
    "typescript": "^5.7.2"
  }
}
