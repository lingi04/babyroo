generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String   @id
  displayName         String
  homeRegion          String   @default("서울")
  homeAddress         Json?
  preferredLocalities String[] @default([])
  activeChildIds      String[] @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  children Child[]
  recommendationSessions RecommendationSession[]

  @@map("users")
}

model Child {
  id        String   @id
  userId    String
  nickname  String
  birthDate String
  gender    String   @default("unknown")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("children")
}

model Event {
  id                  String    @id
  csvSequence         Int       @unique @map("csv_sequence")
  title               String
  venueName           String    @map("venue_name")
  venueDetail         String?   @map("venue_detail")
  address             String?
  imageUrl            String?   @map("image_url")
  locality            String
  region              String
  category            String
  source              String
  sourceEventId       String?   @map("source_event_id")
  startsAt            DateTime  @map("starts_at") @db.Date
  endsAt              DateTime  @map("ends_at") @db.Date
  ageMinMonths        Int?      @map("age_min_months")
  ageMaxMonths        Int?      @map("age_max_months")
  indoor              Boolean?
  priceText           String?   @map("price_text")
  priceType           String    @default("unknown") @map("price_type")
  reservationRequired Boolean?  @map("reservation_required")
  reservationStatus   String    @default("unknown") @map("reservation_status")
  guardianRequired    Boolean?  @map("guardian_required")
  strollerFriendly    Boolean?  @map("stroller_friendly")
  nursingRoom         Boolean?  @map("nursing_room")
  parking             Boolean?
  tags                String[]  @default([])
  summary             String
  sourceUrl           String    @map("source_url")
  lastCheckedAt       DateTime? @map("last_checked_at") @db.Date
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@unique([source, sourceEventId])
  @@index([region, locality])
  @@index([category])
  @@index([startsAt, endsAt])
  @@index([priceType])
  @@index([reservationStatus])
  @@index([source])
  @@map("events")
}

model RecommendationSession {
  id                       String   @id
  userId                   String   @map("user_id")
  selectedChildIds          String[] @default([]) @map("selected_child_ids")
  selectedChildrenSnapshot Json     @map("selected_children_snapshot")
  answers                  Json
  preferences              Json
  results                  Json
  creditCost               Int      @default(0) @map("credit_cost")
  status                   String
  error                    Json?
  createdAt                DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("recommendation_sessions")
}
