generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String   @id
  displayName         String
  homeRegion          String   @default("서울")
  homeAddress         Json?
  preferredLocalities String[] @default([])
  activeChildIds      String[] @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  children Child[]
  recommendationSessions RecommendationSession[]
  creditAccount CreditAccount?
  creditLedgerEntries CreditLedgerEntry[]
  googlePlayPurchases GooglePlayPurchase[]
  pushDevices PushDevice[]

  @@map("users")
}

model PushDevice {
  installationId String @id @map("installation_id")
  userId String @map("user_id")
  token String
  provider String @default("fcm")
  platform String
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_devices")
  @@unique([provider, token])
}

model AdminUser {
  id          String   @id
  googleSub   String?  @unique @map("google_sub")
  email       String   @unique
  displayName String?  @map("display_name")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  eventAuditLogs EventAuditLog[]

  @@map("admin_users")
}

model CreditAccount {
  userId    String   @id @map("user_id")
  available Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credit_accounts")
}

model CreditLedgerEntry {
  id        String   @id
  userId    String   @map("user_id")
  amount    Int
  reason    String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  googlePlayPurchases GooglePlayPurchase[]

  @@index([userId, createdAt])
  @@map("credit_ledger_entries")
}

model GooglePlayPurchase {
  id                    String   @id
  userId                String   @map("user_id")
  productId             String   @map("product_id")
  packageName           String   @map("package_name")
  purchaseToken         String   @unique @map("purchase_token")
  orderId               String?  @map("order_id")
  purchaseState         Int?     @map("purchase_state")
  consumptionState      Int?     @map("consumption_state")
  acknowledgementState  Int?     @map("acknowledgement_state")
  credits               Int
  creditedLedgerEntryId String   @map("credited_ledger_entry_id")
  rawResponse           Json?    @map("raw_response")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditedLedgerEntry CreditLedgerEntry @relation(fields: [creditedLedgerEntryId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("google_play_purchases")
}

model Child {
  id        String   @id
  userId    String
  nickname  String
  birthDate String
  gender    String   @default("unknown")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("children")
}

model Event {
  id                  String    @id
  csvSequence         Int?      @unique @map("csv_sequence")
  title               String
  venueName           String?   @map("venue_name")
  venueDetail         String?   @map("venue_detail")
  address             String?
  imageUrl            String?   @map("image_url")
  locality            String?
  region              String?
  category            String?
  source              String    @default("manual")
  sourceEventId       String?   @map("source_event_id")
  startsAt            DateTime? @map("starts_at") @db.Date
  endsAt              DateTime? @map("ends_at") @db.Date
  ageMinMonths        Int?      @map("age_min_months")
  ageMaxMonths        Int?      @map("age_max_months")
  indoor              Boolean?
  priceText           String?   @map("price_text")
  priceType           String    @default("unknown") @map("price_type")
  reservationRequired Boolean?  @map("reservation_required")
  reservationStatus   String    @default("unknown") @map("reservation_status")
  guardianRequired    Boolean?  @map("guardian_required")
  strollerFriendly    Boolean?  @map("stroller_friendly")
  nursingRoom         Boolean?  @map("nursing_room")
  parking             Boolean?
  tags                String[]  @default([])
  summary             String?
  sourceUrl           String    @map("source_url")
  lastCheckedAt       DateTime? @map("last_checked_at") @db.Date
  publicationStatus   String    @default("draft") @map("publication_status")
  adminUpdatedAt      DateTime? @map("admin_updated_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  eventAuditLogs EventAuditLog[]

  @@unique([source, sourceEventId])
  @@index([region, locality])
  @@index([category])
  @@index([startsAt, endsAt])
  @@index([priceType])
  @@index([reservationStatus])
  @@index([publicationStatus])
  @@index([source])
  @@map("events")
}

model EventAuditLog {
  id          String   @id
  eventId     String   @map("event_id")
  adminUserId String   @map("admin_user_id")
  action      String
  before      Json?
  after       Json?
  createdAt   DateTime @default(now()) @map("created_at")

  adminUser AdminUser @relation(fields: [adminUserId], references: [id])
  event      Event     @relation(fields: [eventId], references: [id])

  @@index([eventId, createdAt])
  @@index([adminUserId, createdAt])
  @@map("event_audit_logs")
}

model RecommendationSession {
  id                       String   @id
  userId                   String   @map("user_id")
  selectedChildIds          String[] @default([]) @map("selected_child_ids")
  selectedChildrenSnapshot Json     @map("selected_children_snapshot")
  answers                  Json
  preferences              Json
  results                  Json
  creditCost               Int      @default(0) @map("credit_cost")
  status                   String
  error                    Json?
  createdAt                DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("recommendation_sessions")
}
